# Build outputs.
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.dSYM
build/
build-*/

# Extracted/built binutils-tricore tree (committed prebuilts in
# third_party/binutils-tricore-prebuilt/ are extracted into here on demand).
third_party/binutils-tricore/

# Top-level binaries from the Makefile target list.
/smoke
/bench
/run_tests
/roundtrip_all

# Rust.
bindings/rust/target/
bindings/rust/Cargo.lock
bindings/rust-ipc/target/
bindings/rust-ipc/Cargo.lock

# Python.
bindings/python/build/
bindings/python/dist/
bindings/python/*.egg-info/
bindings/python/nyxstone_tricore_gcc/_native.*
# Absolute-path object trees leaked by old setup.py versions
# (ffibuilder.compile(tmpdir='.') with resolved source paths); keep these
# ignored so they can't come back if an old checkout's setup.py runs.
bindings/python/home/
bindings/python/workspaces/
__pycache__/
*.pyc
